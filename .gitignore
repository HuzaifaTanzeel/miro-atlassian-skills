# Claude.ai upload zips. The pack workflow commits claude-upload/*.zip and overwrites them.
# Anything else dropped in that folder stays local. Hand-made zips next to a skill stay local too.
claude-upload/*
!claude-upload/*.zip
skills/*.zip

